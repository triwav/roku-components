<?xml version="1.0" encoding="utf-8" ?>
<component name="OpenGrid" extends="Group">
	<script type="text/brightscript" uri="OpenGrid.brs" />

	<interface>
		<!-- TODO still need to add support for updating as more content is needed -->
		<field id="contentNeeded" type="assocarray" />

		<field id="contentQueueId" type="string" />

		<field id="disableAnimation" type="boolean" value="false" />
		<field id="animateToRowItem" type="array" value="[0, 0]" />
		<field id="jumpToRowItem" type="array" value="[0, 0]" />
		<field id="width" type="integer" />
		<field id="height" type="integer" />
		<field id="focusXOffset" type="integer" />
		<field id="focusYOffset" type="integer" />
		<field id="focusBitmapUri" type="uri" />
		<field id="focusBitmapBlendColor" type="color" />
		<field id="focusFootprintBitmapUri" type="uri" />
		<field id="focusFootprintBlendColor" type="color" />

		<!-- Do not observe. Instead observe the boolean counterpart and use getRef instead -->
		<field id="focusedHeaderInfo" type="assocarray" />
		<field id="focusedHeaderInfoChanged" type="boolean" alwaysNotify="true" />

		<!-- Do not observe. Instead observe the boolean counterpart and use getRef instead -->
		<field id="selectedHeaderInfo" type="assocarray" />
		<field id="selectedHeaderInfoChanged" type="boolean" alwaysNotify="true" />

		<!-- Do not observe. Instead observe the boolean counterpart and use getRef instead -->
		<field id="focusedRowItemInfo" type="assocarray" />
		<field id="focusedRowItemInfoChanged" type="boolean" alwaysNotify="true" />

		<!-- Do not observe. Instead observe the boolean counterpart and use getRef instead -->
		<field id="selectedRowItemInfo" type="assocarray" />
		<field id="selectedRowItemInfoChanged" type="boolean" alwaysNotify="true" />

		<field id="currFocusRow" type="float" />

		<!-- Should we expose this?-->
		<field id="renderedRowsRef" type="assocarray" />
	</interface>
	<children>
		<Group id="gridVerticalScroll" />
		<Group id="focusFeedback" visible="false">
			<Poster id="focusFeedbackPoster" />
		</Group>
	</children>
</component>
